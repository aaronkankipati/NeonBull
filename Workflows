name: Neon Bull Backup Cron

on:
  schedule:
    # Morning session — 9:30 AM IST = 04:00 UTC
    - cron: '0 4 * * 1-5'
    # Afternoon session — 2:30 PM IST = 09:00 UTC
    - cron: '0 9 * * 1-5'

jobs:
  trigger:
    runs-on: ubuntu-latest

    steps:
      - name: Fire trading session
        run: |
          RESPONSE=$(curl -s -o response.txt -w "%{http_code}" \
            "${{ secrets.WORKER_URL }}/run-now?secret=${{ secrets.MANUAL_SECRET }}")
          echo "HTTP status: $RESPONSE"
          echo "Response body:"
          cat response.txt
          # Exit with error if not 200 so GitHub marks the run as failed
          if [ "$RESPONSE" != "200" ]; then
            echo "Worker returned non-200 status"
            exit 1
          fi
